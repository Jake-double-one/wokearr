# Plex-Verbindung - ohne diese beiden Variablen startet die App im Demo-Modus
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

# Exakte Namen eurer Plex-Bibliotheken, kommagetrennt
LIBRARY_SECTIONS=Filme,Serien

# Position der Score-Badge auf dem Poster: top-right | top-left | bottom-right | bottom-left
BADGE_POSITION=top-right

# Beschriftung der Badge: "percent" -> "37%", "woke" -> "37% woke"
BADGE_LABEL_STYLE=percent

# Breite der Badge relativ zur Posterbreite, in Prozent (z.B. 20 = 20% der
# Posterbreite). Mindestwert ist fest bei 20 verankert - kleinere Werte werden
# automatisch auf 20 angehoben, da die Badge sonst schnell unleserlich wird.
BADGE_WIDTH_PERCENT=20

# Autopilot-Intervall (Minuten). 0 = deaktiviert (Standard) - dann nur ueber
# die Buttons in der UI. Ein Lauf macht automatisch ALLES: Score-Sync,
# Original-Poster-Cache pflegen, entfernte Titel aufraeumen und neue/geaenderte
# Titel badgen + nach Plex hochladen. Fuer echten "laeuft von allein"-Betrieb
# z.B. auf 60 setzen (stuendlich).
AUTO_SYNC_INTERVAL_MINUTES=0

# Mindestabstand zwischen zwei Sitemap-Abrufen (manuell per Button oder automatisch),
# damit isitwokeornot.com nicht zu haeufig angefragt wird.
CACHE_REBUILD_COOLDOWN_MINUTES=5

# Nach jedem Uebertragen (Push zu Plex) automatisch aeltere, selbst
# hochgeladene Poster-Versionen in Plex loeschen (Plex behaelt die sonst fuer
# immer als Poster-Historie).
CLEANUP_OLD_POSTERS=true
