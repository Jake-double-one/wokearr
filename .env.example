# Plex connection - without these two variables, the app starts in demo mode
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

# Exact names of your Plex libraries, comma-separated
LIBRARY_SECTIONS=Filme,Serien

# UI language (buttons, messages in the browser). Available: en-US, de-DE,
# fr-FR, es-ES, it-IT, pl-PL, tr-TR. en-US is the default and also the
# fallback for individual missing translations in other languages.
LANGUAGE=en-US

# Time zone for log times AND the AUTO_SYNC_CRON schedule, e.g. Europe/Berlin.
# Without it the container runs on UTC - "0 7-23 * * *" then means 7-23 o'clock
# UTC, not your local time.
TZ=Etc/UTC

# Position of the score badge on the poster: top-right | top-left | bottom-right | bottom-left
BADGE_POSITION=top-right

# Badge label: "percent" -> "37%", "woke" -> "37% woke"
BADGE_LABEL_STYLE=percent

# Color palette for the five score bands (0-19 not woke, 20-39 slightly woke,
# 40-59 woke, 60-79 very woke, 80-100 super woke):
#   standard -> the colors isitwokeornot.com uses themselves
#               (green, lime, amber, orange, rose)
#   modified -> alternative ramp (green, yellow, orange, red, violet)
# The bands themselves are fixed - they are the source's classification.
BADGE_COLOR_SCHEME=standard

# Badge width relative to poster width, in percent (e.g. 20 = 20% of the
# poster width). Hard-floored at 20 - lower values are automatically raised,
# since the badge otherwise quickly becomes unreadable on smaller posters.
BADGE_WIDTH_PERCENT=20

# Autopilot schedule as a standard 5-field cron expression (minute hour
# day-of-month month day-of-week), evaluated in TZ (see above).
# Empty/unset or "0" = disabled (default) - then only via the buttons in the
# UI. A run automatically does EVERYTHING: score sync, maintain the
# original-poster cache, clean up removed titles, and badge + upload
# new/changed titles to Plex. Examples: "0 * * * *" hourly, "0 3 * * *"
# daily at 3 AM, "0 */6 * * *" every 6 hours. Build/check expressions at
# https://crontab.guru/.
AUTO_SYNC_CRON=

# Minimum gap between two sitemap fetches (manual via button or automatic),
# so isitwokeornot.com isn't queried too often.
CACHE_REBUILD_COOLDOWN_MINUTES=5

# How long entries in the run protocol (footer) are kept: <number><unit> with
# d(ays), w(eeks) or m(onths, 30 days), e.g. 3d, 4w, 6m. "0" keeps everything.
RUN_HISTORY_RETENTION=4w

# After every push (upload to Plex), automatically delete older, self-
# uploaded poster versions in Plex (Plex otherwise keeps them forever as
# poster history).
CLEANUP_OLD_POSTERS=true

# Notifications about autopilot runs. Empty = off. Formats (as in Apprise):
#   gotify://host/APP_TOKEN, gotifys://host/APP_TOKEN (https)
#   ntfy://TOPIC (ntfy.sh), ntfy://host/TOPIC, ntfys://host/TOPIC (https)
#   any http(s):// URL -> generic JSON webhook
# Test it with: docker exec wokearr python notify.py
NOTIFY_URL=

# What to notify about: "error" (a stage failed) and/or "changes" (new titles
# badged, scores of titles in your library changed), comma-separated.
NOTIFY_ON=error,changes

# Detail of the container log: DEBUG | INFO | WARNING | ERROR. DEBUG adds a
# line per title (fetched, rendered, removed). Messages are always English.
LOG_LEVEL=INFO
