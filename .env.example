PLEX_TOKEN=

# Exakte Namen eurer Plex-Bibliotheken, kommagetrennt
LIBRARY_SECTIONS=Filme,Serien

# Position der Score-Badge auf dem Poster: top-right | top-left | bottom-right | bottom-left
BADGE_POSITION=top-right
